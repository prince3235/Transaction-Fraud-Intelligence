# Sentinel Frontend — Environment Variables
# Copy to .env.local and adjust for your backend

# FastAPI backend URL (default: localhost:8000 for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL for real-time alerts (defaults to ws://localhost:8000/ws/alerts)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/alerts
