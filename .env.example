# ─────────────────────────────────────────────────────────────────────────────
# Transaction Fraud Intelligence Platform — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=fraud_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy database URL (used by API + Streamlit)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Auth ─────────────────────────────────────────────────────────────────────
# Static admin API token (constant-time compared in get_current_user).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# Set to 1 to seed demo users on startup. Leave 0 in production.
SEED_DEMO_USERS=0

# Demo user passwords (only used if SEED_DEMO_USERS=1). If unset, secure
# random passwords are generated and logged once.
# DEMO_USER_ADMIN_PASSWORD=
# DEMO_USER_ANALYST_PASSWORD=
# DEMO_USER_COMPLIANCE_PASSWORD=
# DEMO_USER_AUDITOR_PASSWORD=
# DEMO_USER_VIEWER_PASSWORD=

# ── LLM Copilot ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the API
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# ── Drift monitoring ─────────────────────────────────────────────────────────
DRIFT_CHECK_INTERVAL_MINUTES=30

# ── DVC (uncomment + fill when ready to push to S3) ──────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
